  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#527C61",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#6D9B7A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#71FFAD"
      }
    },
    {
      "name": "Constants and language atoms",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A2FFC2"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#B7F36B"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#39FF88"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "Interfaces, enums and traits",
      "scope": [
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.trait"
      ],
      "settings": {
        "foreground": "#86EFAC"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "meta.definition.variable",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#C6F7D4"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8FE6A8"
      }
    },
    {
      "name": "PHP variables",
      "scope": [
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "name": "PHP tags and punctuation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.tag.php",
        "meta.embedded.php"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#39FF88"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B7F36B"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#5EEAD4"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#8FE6A8"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name.css"
      ],
      "settings": {
        "foreground": "#A2FFC2"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#80A98C"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#D8A7FF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#39FF88",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#B7F36B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#86EFAC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5EEAD4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A2FFC2"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A2FFC2"
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF91A2"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#9F1239"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F5D76E",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#5EEAD4",
    "interface": "#86EFAC",
    "enum": "#86EFAC",
    "type": "#5EEAD4",
    "typeParameter": "#B7F36B",
    "function": "#39FF88",
    "method": "#39FF88",
    "parameter": "#C6F7D4",
    "variable": "#C6F7D4",
    "property": "#8FE6A8",
    "enumMember": "#B7F36B",
    "keyword": "#71FFAD",
    "namespace": "#5EEAD4",
    "comment": {
      "foreground": "#527C61",
      "italic": true
    },
    "string": "#A2FFC2",
    "number": "#B7F36B",
    "operator": "#80A98C",
    "macro": "#D8A7FF",
    "decorator": "#5EEAD4"
  }
}