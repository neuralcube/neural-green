    "peekViewEditor.background": "#07100A",
    "peekViewResult.background": "#0A170E",
    "peekViewTitle.background": "#0D2114",
    "peekViewTitleLabel.foreground": "#D7FFE2",
    "peekViewTitleDescription.foreground": "#80A98C",
    "merge.currentHeaderBackground": "#174D31",
    "merge.incomingHeaderBackground": "#14532D",
    "merge.border": "#20462C",
    "debugToolBar.background": "#0D2114",
    "debugIcon.breakpointForeground": "#FF647C",
    "debugIcon.startForeground": "#39FF88",
    "debugIcon.pauseForeground": "#F5D76E",
    "debugIcon.stopForeground": "#FF647C",
    "debugIcon.disconnectForeground": "#F5D76E",
    "debugIcon.restartForeground": "#5EEAD4",
